msgid "The widget adds the hole and the center ring."
msgstr "El agujero y el aro del centro los pone el widget."

#: package/contents/ui/PadDiagram.qml:81
msgid "Open the library"
msgstr "Abrir la librería"

#: package/contents/ui/PadDiagram.qml:82
msgid "hold %1 s"
msgstr "mantener %1 s"

#: package/contents/ui/PadDiagram.qml:82
msgid "press together"
msgstr "pulsar a la vez"

#: package/contents/ui/PadDiagram.qml:83
msgid "Play"
msgstr "Jugar"

#: package/contents/ui/PadDiagram.qml:84
msgid "Leave"
msgstr "Salir"

