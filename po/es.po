msgid "Left stick"
msgstr "Stick izquierdo"

#: package/contents/ui/configGamepad.qml:102
msgid "Right stick"
msgstr "Stick derecho"

#: package/contents/ui/configGamepad.qml:102
msgid "Share"
msgstr "Compartir"

