msgid "Connected:"
msgstr "Conectados:"

#: package/contents/ui/configGamepad.qml:177
msgid "Searching…"
msgstr "Buscando…"

#: package/contents/ui/configGamepad.qml:179
msgid "No gamepad. Connect it via USB or Bluetooth and press “Search”."
msgstr "Ningún mando. Conéctalo por USB o Bluetooth y pulsa «Buscar»."

#: package/contents/ui/configGamepad.qml:184
msgid "Search"
msgstr "Buscar"

#: package/contents/ui/configGamepad.qml:205
