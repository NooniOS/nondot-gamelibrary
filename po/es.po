msgid "Could not save the image to %1."
msgstr "No se pudo guardar la imagen en %1."

#: package/contents/ui/DiscImportDialog.qml:94
msgid ""
"Fit the circle to the edge of the disc: drag it from inside to move it and "
"from its edge to resize it."
msgstr ""
"Ajusta el círculo al borde del disco: arrástralo desde dentro para moverlo y "
"desde su borde para cambiar el tamaño."

#: package/contents/ui/DiscImportDialog.qml:222
#: package/contents/ui/WrapImportDialog.qml:258
msgid "Result"
msgstr "Resultado"

